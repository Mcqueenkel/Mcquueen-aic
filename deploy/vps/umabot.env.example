AIC_CHORES=1
AIC_CLUB_EVERY=60
AIC_ACE=1
AIC_TEAM=1
# claim the gift box, and every Daily Race Ticket in one multi race, once a game-day
AIC_GIFTS=1
AIC_DAILY_RACE=1
# no daily fan cap (0). A number re-arms it: e.g. 28000000 stops each account for
# the game-day once it has gained 28M fans, until the 15:00 UTC reset
AIC_FAN_TARGET=0
AIC_FAN_STOP_MARGIN=0
# no random wait between visits: full speed banks the most fans
AIC_VISIT_JITTER_MIN=0
AIC_VISIT_JITTER_MAX=0
# proxy relay (only when scripts/proxy_setup.sh turned it on): a private file with your
# own proxies, one per line (http://user:pass@host:port or socks5://...). Keep it outside
# the repository, e.g. /etc/aic-proxies.txt. Empty = the free public list.
AIC_PROXY_LIST=
AIC_CAREER_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>
AIC_ALERT_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>
