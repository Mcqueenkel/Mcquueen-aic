AIC_CHORES=1
AIC_CLUB_EVERY=60
AIC_ACE=1
AIC_TEAM=1
# claim the gift box, and every Daily Race Ticket in one multi race, once a game-day
AIC_GIFTS=1
AIC_DAILY_RACE=1
# stop each account for the game-day once it has gained 28M fans (0 margin: the
# career that crosses 28M is banked, then nothing until the 15:00 UTC reset)
AIC_FAN_TARGET=28000000
AIC_FAN_STOP_MARGIN=0
# no random wait between visits: at ~1M fans a career only full speed reaches 28M
AIC_VISIT_JITTER_MIN=0
AIC_VISIT_JITTER_MAX=0
AIC_CAREER_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>
AIC_ALERT_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>
