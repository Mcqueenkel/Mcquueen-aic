# systemd unit for the AIC farm. Install: see README "Install".
#
#   cp deploy/vps/aic.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now aic
#
# Never `systemctl stop aic` on the live box - change things with ONE `systemctl restart aic`
# while the log's last line is "Next visit in ..." (README "Updating").
#
# aic-health.{service,timer} watch the LOG, not this unit: it can sit ACTIVE while every login
# fails, and `systemctl is-active aic` will not tell you.

[Unit]
Description=AutoIndependentCareer idle-career farmer
After=network-online.target
Wants=network-online.target
# Keep going rather than give up: real failures are handled as waits inside the loop, so a
# crash is rare and almost always transient. RestartSec below keeps it to at most one Steam
# login every 5 minutes. (StartLimit* only work in [Unit].)
StartLimitIntervalSec=3600
StartLimitBurst=20

[Service]
Type=simple
User=umabot
Group=umabot
UMask=0077
WorkingDirectory=/opt/aic

# Settings + Discord webhooks (600 root). Template: deploy/vps/umabot.env.example.
EnvironmentFile=/etc/umabot.env

# Game data: data/*.json and node_modules/steam-user.
Environment=AIC_DATA_ROOT=/opt/umabot
# Credentials in /opt/aic/runtime/aic/, state and logs in /opt/aic/state/aic/.
Environment=AIC_PROFILE=aic
Environment=AIC_PY=/home/umabot/.venvs/aic/bin/python
# The game's master.mdb, for trainee-specific race lists (without it the server refuses
# starts with 205). Refresh it from the PC's game install after a game update.
Environment=AIC_MASTER_MDB=/opt/umabot/master.mdb
# TP refills: carats are never spent below this floor.
Environment=AIC_TP_JEWEL_FLOOR=0

# The whole roster (/opt/aic/reroll_accounts.json), forever. --scenario 2 = Unity Cup
# (1 URA, 3 Grand Concert, 4 Trackblazer). --races = the fan races to enter (year:program).
ExecStart=/opt/aic/rotate.sh run --scenario 2 --use-tp 30 --running-style 3 --races 1:637,1:629,1:630,1:632,1:633,1:627,1:624,1:625,2:181,2:169,2:171,2:163,2:164,2:166,2:73,2:74,2:1023,2:82,2:176,2:85,2:76,2:77,2:79,2:80,2:81,3:8,3:9,3:1,3:11,3:3,3:4,3:5,3:73,3:74,3:101,3:82,3:109,3:85,3:76,3:77,3:79,3:80,3:81 --recover-tp --recover-tp-jewels --auto-deck

Restart=always
RestartSec=300
StandardOutput=null

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, not true: the interpreter lives under /home/umabot.
ProtectHome=read-only

# Everything AIC writes. Each directory must exist, or the unit fails with 226/NAMESPACE.
#   state/    logs/aic.log, fan/carat/ace/club state, accounts.json, auth_archive/
#   runtime/  auth_config.json (rewritten when the auth_key or Steam token refreshes)
ReadWritePaths=/opt/aic/state
ReadWritePaths=/opt/aic/runtime
ReadWritePaths=-/opt/aic/reroll_accounts.json

# SIGTERM is only taken between calls, so an in-flight request can finish.
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
